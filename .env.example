# Copy to .dev.vars for local development (`npm run dev` and `npm run preview`).
# In production these are Worker secrets: `npx wrangler secret put PLAID_SECRET`.
# Keys: https://dashboard.plaid.com/developers/keys

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
PLAID_PRODUCTS=transactions

# Needed to link OAuth banks (Chase, Amex, ...). Must exactly match a redirect
# URI registered in the Plaid dashboard. Leave blank for sandbox.
PLAID_REDIRECT_URI=

# Encrypts Plaid access tokens before they're stored (worker/token-crypto.ts).
# 32 random bytes, base64: `openssl rand -base64 32`. Changing it makes every
# linked bank unreadable, so they'd all need relinking.
PLAID_TOKEN_KEY=
