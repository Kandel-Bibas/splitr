{
  "manifest_version": 3,
  "name": "Splitr",
  "version": "0.1.1",
  "description": "Send a Walmart or Sam's Club order to Splitr as an itemized expense.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.walmart.com/*",
    "https://www.samsclub.com/*",
    "https://splitr.bibas.dev/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.walmart.com/*",
        "https://www.samsclub.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://splitr.bibas.dev/*",
        "http://localhost:5173/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
