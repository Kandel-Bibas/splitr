{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splitr",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat fills process.env from the Worker's secrets
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    // The React app is static files; any other path is a page route
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker. Pages and assets are served without it,
    // so they cost no Worker time or requests.
    "run_worker_first": ["/api/*"]
  },
  // The app is only reachable at its own domain, the URL Supabase sends sign-in
  // links to. The default *.workers.dev and preview addresses stay off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "splitr.bibas.dev",
      "custom_domain": true
    }
  ],
  // Postgres on Supabase, reached through Hyperdrive's connection pool.
  // Locally, `wrangler dev` and the tests use localConnectionString instead
  // (the Docker database from test/db/setup.ts).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a3dce64c6ba94b4e8be68c5472865347",
      "localConnectionString": "postgres://postgres:postgres@localhost:54329/postgres"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://hmevfdykiyglpwmwbpau.supabase.co",
    // Real banks; PLAID_CLIENT_ID and PLAID_SECRET (the production one) are secrets
    "PLAID_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
